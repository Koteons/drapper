# Token du bot Discord (depuis discord.com/developers/applications)
DISCORD_TOKEN=ton_token_ici

# ID de l'application Discord (onglet "General Information")
CLIENT_ID=ton_client_id_ici

# ID du serveur Discord pour déploiement rapide (optionnel)
# Si vide, les commandes sont déployées globalement (peut prendre 1h)
# Si rempli, les commandes sont instantanées sur ce serveur uniquement
GUILD_ID=ton_guild_id_ici
